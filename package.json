{
  "name": "embe-love-story",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/clean-next.mjs",
    "build": "next build",
    "prebuild": "node scripts/clean-next.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "node scripts/clean-next.mjs && next typegen",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run check:encoding && npm run typecheck && npm run lint && npm run test",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "check:encoding": "node scripts/check-encoding.mjs"
  },
  "dependencies": {
    "motion": "^12.23.24",
    "next": "16.2.9",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.15.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.9",
    "jsdom": "^30.1.2",
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
